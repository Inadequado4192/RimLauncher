{
    "appId": "com.inadequado4192.rimlauncher",
    "files": [
        "./.webpack/*",
        "!node_modules",
        {
            "from": "src/resources",
            "to": "."
        }
    ],
    "directories": {
        "buildResources": "."
    },
    "icon": "build/icons/icon",
    "publish": [
        {
            "provider": "github",
            "owner": "Inadequado4192",
            "repo": "RimLauncher"
        }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "extraMetadata": {
    "archMapping": {
            "x64": "x64",
            "x86_64": "x64"
        }
    },
    "mac": {
        "target": ["dmg", "zip"]
    },
    "win": {
        "target": ["nsis", "zip"]
    },
    "linux": {
        "target": [ "AppImage", "deb", "rpm", "zip"]
    },
    "nsis": {
        "artifactName": "${productName}-${version}-win-Setup.${ext}",
        "oneClick": false,
        "perMachine": false,
        "allowElevation": true,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    },
    "portable": {
        "artifactName": "${productName}-${version}-win-Portable.${ext}"
    },
    "deb": {
        "artifactName": "${productName}-${version}-linux.${ext}"
    },
    "rpm": {
        "artifactName": "${productName}-${version}-linux.${ext}"
    }
}