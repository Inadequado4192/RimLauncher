{
    "name": "rimlauncher",
    "productName": "RimLauncher",
    "version": "2.2.0",
    "description": "Launcher for RimWorld",
    "main": ".webpack/main.js",
    "imports": {
        "#features/*/main": "./src/features/*/main/index.ts",
        "#features/*/renderer": "./src/features/*/renderer/index.ts",
        "#features/*/shared": "./src/features/*/shared/index.ts"
    },
    "scripts": {
        "dev:main": "webpack --config webpack.main.config.mts --watch",
        "dev:preload": "webpack --config webpack.preload.config.mts --watch",
        "dev:renderer": "webpack serve --config webpack.renderer.config.mts",
        "dev:electron": "wait-on file:.webpack/main.js tcp:3000 && nodemon --quiet --watch .webpack/main.js --exec \"cross-env DEV_SERVER_URL=http://localhost:3000 electron .webpack/main.js\"",
        "dev": "rimraf .webpack && concurrently --kill-others-on-fail -k --raw \"npm:dev:*\"",
        "build:main": "cross-env NODE_ENV=production webpack --config webpack.main.config.mts",
        "build:preload": "cross-env NODE_ENV=production webpack --config webpack.preload.config.mts",
        "build:renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.config.mts",
        "build": "rimraf .webpack && concurrently --raw \"npm:build:*\"",
        "start": "electron ./.webpack/main.js",
        "analiz:main": "cross-env NODE_ENV=production ANALYZE=true webpack --config webpack.main.config.mts",
        "analiz:preload": "cross-env NODE_ENV=production ANALYZE=true webpack --config webpack.preload.config.mts",
        "analiz:renderer": "cross-env NODE_ENV=production ANALYZE=true webpack --config webpack.renderer.config.mts",
        "asar:build": "npm run build && electron-builder --dir",
        "asar:start": "electron ./dist/win-unpacked/resources/app.asar",
        "make": "npm run build && npm run package",
        "package": "node ./build/release-body.js && electron-builder --publish never",
        "release": "node ./build/release-body.js && electron-builder --publish always",
        "do-depcruise": "npx depcruise ./src/features --output-type archi | dot -T svg > tmp/features.svg"
    },
    "author": {
        "name": "Inadequado4192",
        "email": "lozaliya1@gmail.com"
    },
    "license": "MIT",
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.1",
        "@mui/joy": "^5.0.0-beta.52",
        "@mui/material": "^7.3.1",
        "chokidar": "^6.0.0",
        "dompurify": "^3.4.12",
        "electron-updater": "^6.8.11",
        "fast-xml-builder": "^1.3.1",
        "fast-xml-parser": "^5.11.2",
        "lodash": "^4.18.1",
        "marked": "^18.2.1",
        "node-fetch": "^3.3.2",
        "react": "^19.3.1",
        "react-colorful": "^5.8.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-virtualized-auto-sizer": "^2.0.3",
        "react-virtuoso": "^4.18.11",
        "react-window": "^2.3.0",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "use-sync-external-store": "^1.6.0",
        "yauzl": "^3.4.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.27",
        "@types/react-dom": "^19.3.0",
        "@types/react-window": "^2.0.0",
        "@types/unzipper": "^0.10.11",
        "@types/use-sync-external-store": "^1.5.0",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "@types/webpack-env": "^1.18.8",
        "@types/yauzl": "^3.4.0",
        "case-sensitive-paths-webpack-plugin": "^2.4.0",
        "concurrently": "^10.0.6",
        "create-index": "^2.6.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.5",
        "dependency-cruiser": "^18.7.2",
        "electron": "^45.4.1",
        "electron-builder": "^26.18.0",
        "electron-devtools-installer": "^4.0.0",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.14.0",
        "html-webpack-plugin": "^5.6.8",
        "jiti": "^2.7.0",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "wait-on": "^9.5.1",
        "webpack": "^5.112.2",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.3.0",
        "webpack-dev-server": "^6.1.0"
    }
}