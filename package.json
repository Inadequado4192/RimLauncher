{
    "name": "rimlauncher",
    "productName": "RimLauncher",
    "version": "0.9.2",
    "description": "Launcher for RimWorld",
    "main": ".webpack/main.js",
    "scripts": {
        "dev:main": "webpack --config webpack.main.config.ts --watch",
        "dev:preload": "webpack --config webpack.preload.config.ts --watch",
        "dev:renderer": "webpack serve --config webpack.renderer.config.ts",
        "dev:electron": "wait-on http://localhost:3000 && nodemon --quiet --watch .webpack/main.js --exec \"electron ./.webpack/main.js\"",
        "dev": "rimraf .webpack && concurrently -k --raw \"npm:dev:*\"",
        "build": "cross-env NODE_ENV=production webpack --config webpack.main.config.ts && cross-env NODE_ENV=production webpack --config webpack.preload.config.ts && cross-env NODE_ENV=production webpack --config webpack.renderer.config.ts",
        "package": "electron-builder --publish never",
        "make": "npm run build && npm run package",
        "asar": "electron-builder --dir",
        "temp": "electron ./dist/win-unpacked/resources/app.asar"
    },
    "author": {
        "name": "Inadequado4192",
        "email": "lozaliya1@gmail.com"
    },
    "license": "MIT",
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hookform/resolvers": "^5.2.1",
        "@mui/icons-material": "^7.3.1",
        "@mui/joy": "^5.0.0-beta.52",
        "@mui/material": "^7.3.1",
        "cheerio": "^1.1.2",
        "chokidar": "^4.0.3",
        "dompurify": "^3.2.6",
        "electron-updater": "^6.6.2",
        "fast-xml-parser": "^5.2.5",
        "node-fetch": "^3.3.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-hook-form": "^7.62.0",
        "react-icons": "^5.5.0",
        "react-intersection-observer": "^9.16.0",
        "react-virtualized-auto-sizer": "^1.0.26",
        "react-window": "^1.8.11",
        "unzipper": "^0.12.3",
        "use-sync-external-store": "^1.5.0",
        "zod": "^4.0.15"
    },
    "devDependencies": {
        "@types/react-dom": "^19.1.7",
        "@types/react-window": "^1.8.8",
        "@types/unzipper": "^0.10.11",
        "@types/use-sync-external-store": "^1.5.0",
        "concurrently": "^9.2.0",
        "create-index": "^2.6.0",
        "cross-env": "^10.0.0",
        "css-loader": "^7.1.2",
        "electron": "^30.5.1",
        "electron-builder": "^24.13.3",
        "html-webpack-plugin": "^5.6.3",
        "nodemon": "^3.1.10",
        "rimraf": "^6.0.1",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "typescript": "^5.9.2",
        "wait-on": "^8.0.4",
        "webpack": "^5.101.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.2"
    }
}
