{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "jsx": "react-jsx",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "outDir": "dist",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        
        "removeComments": true,
        "strict": true,
        "downlevelIteration": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "useUnknownInCatchVariables": true,
        "alwaysStrict": true,
        "noUncheckedIndexedAccess": true,
        "incremental": true,
        "noImplicitOverride": true,

        "baseUrl": "./src",
        "paths": {
            "@Common/*": ["common/*"],
            "@Main/*": ["main/*"],
            "@Renderer/*": ["view/*"],
            
            "@Resources/*": ["resources/*"],
            "@Localization": ["resources/localization"],
            "@Localization/*": ["resources/localization/*"],
            "@Tools/*": ["main/tools/*"],
            "@Events/*": ["main/events/*"],

            "@Utils/common": ["common/utils"],
            "@Utils/main": ["main/utils"],
            "@Utils/renderer": ["view/utils"],

            "@Components": ["view/scripts/Components"],
            "@Components/*": ["view/scripts/Components/*"],
            "@Parts": ["view/scripts/Components/Parts"],
            "@Parts/*": ["view/scripts/Components/Parts/*"],
            "@Icons": ["view/scripts/Components/Icons"],
            "@Icons/*": ["view/scripts/Components/Icons/*"],
            "@Context": ["view/scripts/Context"],
            "@Context/*": ["view/scripts/Context/*"],
            "@Services": ["view/scripts/Services"],
            "@Services/*": ["view/scripts/Services/*"],
            "@Windows": ["view/scripts/Windows"],
            "@Windows/*": ["view/scripts/Windows/*"],
            "@Modules": ["view/scripts/Modules"],
            "@Modules/*": ["view/scripts/Modules/*"],
            "@Classes": ["view/scripts/Classes"],
            "@Classes/*": ["view/scripts/Classes/*"],
            "@Stores": ["view/scripts/Stores"],
            "@Stores/*": ["view/scripts/Stores/*"],
        }
    },
    "include": ["src/**/*"]
}