{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "jsx": "react-jsx",
        "types": ["webpack-env"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        
        "removeComments": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "useUnknownInCatchVariables": true,
        "alwaysStrict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        
        "incremental": true,
        "noImplicitOverride": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata":true,

        "paths": {
            "@Common/*": ["./_src/common/*"],
            "@Main/*": ["./_src/main/*"],
            "@Renderer/*": ["./_src/view/*"],
            
            "@Resources/*": ["./_src/resources/*"],
            "@Localization": ["./_src/resources/localization"],
            "@Localization/*": ["./_src/resources/localization/*"],
            "@Tools/*": ["./_src/main/tools/*"],
            "@Events/*": ["./_src/main/events/*"],

            "@Utils/common": ["./_src/common/utils"],
            "@Utils/main": ["./_src/main/utils"],
            "@Utils/renderer": ["./_src/view/utils"],

            "@Components": ["./_src/view/scripts/Components"],
            "@Components/*": ["./_src/view/scripts/Components/*"],
            "@Parts": ["./_src/view/scripts/Components/Parts"],
            "@Parts/*": ["./_src/view/scripts/Components/Parts/*"],
            "@Icons": ["./_src/view/scripts/Components/Icons"],
            "@Icons/*": ["./_src/view/scripts/Components/Icons/*"],
            "@Context": ["./_src/view/scripts/Context"],
            "@Context/*": ["./_src/view/scripts/Context/*"],
            "@Services": ["./_src/view/scripts/Services"],
            "@Services/*": ["./_src/view/scripts/Services/*"],
            "@Windows": ["./_src/view/scripts/Windows"],
            "@Windows/*": ["./_src/view/scripts/Windows/*"],
            "@Modules": ["./_src/view/scripts/Modules"],
            "@Modules/*": ["./_src/view/scripts/Modules/*"],
            "@Classes": ["./_src/view/scripts/Classes"],
            "@Classes/*": ["./_src/view/scripts/Classes/*"],
            "@Stores": ["./_src/view/scripts/Stores"],
            "@Stores/*": ["./_src/view/scripts/Stores/*"],
        },
    },
    "include": ["src/**/*", "_src/**/*"],
}