{
    "compilerOptions": {
      "target": "ESNext",
      "module": "commonjs",
      "jsx": "react-jsx",
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "noImplicitAny": true,
      "sourceMap": true,
      "outDir": "dist",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      
      "removeComments": true,
      "strict": true,
      "downlevelIteration": true,
      "forceConsistentCasingInFileNames": true,
      "allowSyntheticDefaultImports": true,
      "useUnknownInCatchVariables": true,
      "alwaysStrict": true,
      "noUncheckedIndexedAccess": true,
      "incremental": true,
  
      "baseUrl": ".",
      "paths": {
        // "@mui/material": ["./node_modules/@mui/joy"],
        "@common/*": ["./src/common/*"],
        "@localization": ["./src/localization"],
        "@localization/*": ["./src/localization/*"],


        "@Components": ["./src/view/assets/scripts/Components"],
        "@Components/*": ["./src/view/assets/scripts/Components/*"],
        "@Parts": ["./src/view/assets/scripts/Components/Parts"],
        "@Parts/*": ["./src/view/assets/scripts/Components/Parts/*"],
        "@Icons": ["./src/view/assets/scripts/Components/Icons"],
        "@Icons/*": ["src/view/assets/scripts/Components/Icons/*"],
        "@Context": ["./src/view/assets/scripts/Context"],
        "@Context/*": ["./src/view/assets/scripts/Context/*"],
        "@Services": ["./src/view/assets/scripts/Services"],
        "@Services/*": ["./src/view/assets/scripts/Services/*"],
        "@Windows": ["./src/view/assets/scripts/Windows"],
        "@Windows/*": ["./src/view/assets/scripts/Windows/*"],
        "@Modules": ["./src/view/assets/scripts/Modules"],
        "@Modules/*": ["./src/view/assets/scripts/Modules/*"],
      }
    },
    "include": ["src/**/*", "test.ts"]
  }
  