{
    "compilerOptions": {
      "target": "ESNext",
      "module": "commonjs",
      "jsx": "react-jsx",
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "noImplicitAny": true,
      "sourceMap": true,
      "outDir": "dist",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      
      "removeComments": true,
      "strict": true,
      "downlevelIteration": true,
      "forceConsistentCasingInFileNames": true,
      "allowSyntheticDefaultImports": true,
      "useUnknownInCatchVariables": true,
      "alwaysStrict": true,
      "noUncheckedIndexedAccess": true,
      "incremental": true,
  
      "baseUrl": ".",
      "paths": {
        "@Common/*": ["./src/common/*"],
        "@Localization": ["./src/localization"],
        "@Localization/*": ["./src/localization/*"],
        
        "@Tools/*": ["./src/main/tools/*"],
        "@Events/*": ["./src/main/events/*"],



        "@Components": ["src/view/scripts/Components"],
        "@Components/*": ["src/view/scripts/Components/*"],
        "@Parts": ["src/view/scripts/Components/Parts"],
        "@Parts/*": ["src/view/scripts/Components/Parts/*"],
        "@Icons": ["src/view/scripts/Components/Icons"],
        "@Icons/*": ["src/view/scripts/Components/Icons/*"],
        "@Context": ["src/view/scripts/Context"],
        "@Context/*": ["src/view/scripts/Context/*"],
        "@Services": ["src/view/scripts/Services"],
        "@Services/*": ["src/view/scripts/Services/*"],
        "@Windows": ["src/view/scripts/Windows"],
        "@Windows/*": ["src/view/scripts/Windows/*"],
        "@Modules": ["src/view/scripts/Modules"],
        "@Modules/*": ["src/view/scripts/Modules/*"],
        "@Classes": ["src/view/scripts/Classes"],
        "@Classes/*": ["src/view/scripts/Classes/*"],
      }
    },
    "include": ["src/**/*", "test.ts"]
  }
  